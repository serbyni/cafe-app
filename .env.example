# Copy to .env.local (never commit real values). Same Supabase project as super-admin-app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cafés live at <slug>.<root>. Local: localhost:3000 → http://<slug>.localhost:3000
# dev: dev.serbi.me (→ <slug>.dev.serbi.me) · prod: serbi.me (→ <slug>.serbi.me)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Platform app (register, owner dashboard). Local: http://localhost:3001 if both run.
NEXT_PUBLIC_PLATFORM_URL=https://dev.serbi.me

# Only for `npm run db:types`
SUPABASE_PROJECT_REF=<project-ref>
